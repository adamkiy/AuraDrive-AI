# Batch files must keep CRLF: cmd.exe mishandles labels and goto in a .bat with
# Unix line endings, and git would otherwise normalise them on checkout.
*.bat text eol=crlf

# Shell scripts and the macOS launcher must keep LF for the same reason in
# reverse: a shebang followed by CR is not a valid interpreter path.
*.sh       text eol=lf
*.command  text eol=lf

# Treat these as binary so git never rewrites them.
*.jsonl -text
*.pdf   binary
*.docx  binary
*.pptx  binary
