# Shell scripts and the macOS launcher must keep LF: a shebang followed by a
# carriage return is not a valid interpreter path, and Git Bash on Windows runs
# these files too.
*.sh       text eol=lf
*.command  text eol=lf

# Treat these as binary so git never rewrites them.
*.jsonl -text
*.pdf   binary
*.docx  binary
*.pptx  binary
